/* =====================================================
   State
   ===================================================== */
let current = 0;
let answers = new Array(QUESTIONS.length).fill(null);

const views = {
  intro: document.getElementById('view-intro'),
  quiz: document.getElementById('view-quiz'),
  results: document.getElementById('view-results'),
  trainer: document.getElementById('view-trainer'),
};

function setView(name){
  Object.values(views).forEach(v => v.classList.remove('active'));
  views[name].classList.add('active');
  window.scrollTo({top:0, behavior:'smooth'});
}

function showIntro(){ setView('intro'); }

function startQuiz(){
  current = 0;
  answers = new Array(QUESTIONS.length).fill(null);
  renderQuestion();
  setView('quiz');
}

function renderQuestion(){
  const q = QUESTIONS[current];
  document.getElementById('qSkill').textContent = q.skill;
  document.getElementById('qScenario').textContent = q.scenario;
  document.getElementById('progressCount').textContent = `السؤال ${current+1} من ${QUESTIONS.length}`;
  document.getElementById('progressFill').style.width = `${((current+1)/QUESTIONS.length)*100}%`;

  const letters = ['أ','ب','ج','د'];
  const optWrap = document.getElementById('qOptions');
  optWrap.innerHTML = '';
  q.options.forEach((opt, i) => {
    const div = document.createElement('div');
    div.className = 'option' + (answers[current] === i ? ' selected' : '');
    div.onclick = () => selectOption(i);
    div.innerHTML = `<span class="opt-letter">${letters[i]}</span><span class="opt-text">${opt.text}</span>`;
    optWrap.appendChild(div);
  });

  const nextBtn = document.getElementById('nextBtn');
  nextBtn.disabled = answers[current] === null;
  nextBtn.textContent = current === QUESTIONS.length - 1 ? 'عرض النتيجة →' : 'التالي →';
}

function selectOption(i){
  answers[current] = i;
  renderQuestion();
}

function nextQuestion(){
  if(answers[current] === null) return;
  if(current < QUESTIONS.length - 1){
    current++;
    renderQuestion();
  } else {
    showResults();
  }
}

let lastScore = 0;

function showResults(){
  let score = 0;
  const skillMap = {};

  QUESTIONS.forEach((q, i) => {
    const correctIndex = q.options.findIndex(o => o.correct);
    const isCorrect = answers[i] === correctIndex;
    if(isCorrect) score++;

    if(!skillMap[q.skill]) skillMap[q.skill] = { correct: 0, total: 0 };
    skillMap[q.skill].total++;
    if(isCorrect) skillMap[q.skill].correct++;
  });
  lastScore = score;

  document.getElementById('scoreNum').textContent = `${score}/${QUESTIONS.length}`;
  const circumference = 415;
  const offset = circumference - (score / QUESTIONS.length) * circumference;
  document.getElementById('scoreRing').style.strokeDashoffset = offset;

  let band, msg;
  if(score <= 3){
    band = '🌱 بداية طريق التطبيق';
    msg = 'ما زلت في مرحلة ربط المفاهيم بالتطبيق الفعلي. راجعي الأمثلة العملية في دليل المتدرب، واستمري بتطبيق خطة فردية واحدة كاملة مع طالب من صفك — الممارسة المتكررة هي أسرع طريق للإتقان.';
  } else if(score <= 6){
    band = '📘 نمو ملحوظ، استمري بالممارسة';
    msg = 'إجاباتك تعكس نموًا حقيقيًا في تطبيق مبادئ البرنامج مقارنة بما قبل التدريب. ركّزي في الفترة القادمة على المهارات التي بدت أقل ثباتًا في التفصيل أدناه.';
  } else if(score <= 8){
    band = '🌟 تطبيق واثق لمبادئ البرنامج';
    msg = 'تُظهر إجاباتك قدرة جيدة على تحليل المواقف واتخاذ قرارات مهنية مبنية على أدلة. واصلي توثيق أثر خطتك الفردية، فهذا ما يرسّخ هذا المستوى ويجعله ممارسة يومية مستقرة.';
  } else {
    band = '🏆 إتقان عملي متكامل';
    msg = 'مستوى تطبيقك للمبادئ التي تدربتِ عليها متقدم جدًا وينتقل بوضوح من المعرفة النظرية إلى الممارسة المهنية. فكري في مشاركة خبرتك مع زميلاتك عبر مجتمع تعلم مهني داخل المدرسة.';
  }
  document.getElementById('resultBand').textContent = band;
  document.getElementById('resultMsg').textContent = msg;

  document.getElementById('preScoreInput').value = '';
  document.getElementById('compareResult').style.display = 'none';

  const breakdownWrap = document.getElementById('skillBreakdown');
  breakdownWrap.innerHTML = '';
  Object.entries(skillMap).forEach(([skill, val]) => {
    const pct = Math.round((val.correct / val.total) * 100);
    const row = document.createElement('div');
    row.className = 'skill-row';
    row.innerHTML = `
      <div class="skill-row-top">
        <span class="skill-name">${skill}</span>
        <span class="skill-frac">${val.correct}/${val.total}</span>
      </div>
      <div class="skill-track"><div class="skill-fill" style="width:${pct}%"></div></div>
    `;
    breakdownWrap.appendChild(row);
  });

  setView('results');
}

function compareGrowth(){
  const input = document.getElementById('preScoreInput');
  const pre = parseInt(input.value, 10);
  const resultBox = document.getElementById('compareResult');

  if(isNaN(pre) || pre < 0 || pre > 10){
    resultBox.style.display = 'block';
    resultBox.style.color = 'var(--red)';
    resultBox.textContent = 'أدخلي رقمًا صحيحًا بين 0 و10 (درجتك في الاختبار القبلي).';
    return;
  }

  const delta = lastScore - pre;
  resultBox.style.display = 'block';
  resultBox.style.color = delta >= 0 ? 'var(--green)' : 'var(--ink-soft)';

  if(delta > 0){
    resultBox.textContent = `📈 نموّك: من ${pre}/10 إلى ${lastScore}/10 — تقدّم بمقدار ${delta} ${delta === 1 ? 'نقطة' : 'نقاط'}. أثر واضح للتدريب!`;
  } else if(delta === 0){
    resultBox.textContent = `➡️ درجتك ثابتة عند ${lastScore}/10 في الاختبارين. راجعي التفصيل أدناه لتحديد مهارة معينة تحتاج تطبيقًا أكثر.`;
  } else {
    resultBox.textContent = `درجتك الحالية ${lastScore}/10 مقابل ${pre}/10 قبليًا. المواقف البعدية أكثر تطبيقية وتفصيلًا، وهذا طبيعي أحيانًا — راجعي التفصيل أدناه لتحديد أين تحتاجين دعمًا إضافيًا.`;
  }
}

function restartQuiz(){ startQuiz(); }

/* =====================================================
   Trainer view
   ===================================================== */
function showTrainer(){
  const letters = ['أ','ب','ج','د'];
  const wrap = document.getElementById('trainerList');
  wrap.innerHTML = '';
  QUESTIONS.forEach((q, i) => {
    const correctIndex = q.options.findIndex(o => o.correct);
    const box = document.createElement('div');
    box.className = 'trainer-box';
    box.innerHTML = `
      <div class="tb-q">السؤال ${i+1}</div>
      <div class="tb-scenario">${q.scenario}</div>
      <div class="tb-answer">✅ الإجابة الصحيحة: (${letters[correctIndex]}) ${q.options[correctIndex].text}</div>
      <div class="tb-rationale">${q.rationale}</div>
      <div class="tb-tags">
        <span class="tb-skilltag">${q.skill}</span>
        <span class="tb-levelTag">مستوى التفكير: ${q.level}</span>
      </div>
    `;
    wrap.appendChild(box);
  });

  const currentUrl = window.location.href;
  const isRealUrl = !currentUrl.startsWith('file://') && !currentUrl.startsWith('blob:');
  document.getElementById('qrUrlInput').value = isRealUrl ? currentUrl : '';
  generateQR(isRealUrl ? currentUrl : '');

  setView('trainer');
}

function generateQR(url){
  document.getElementById('qrcode').innerHTML = '';
  url = (url || '').trim();

  if(!url){
    document.getElementById('qrUrl').textContent = 'الصقي رابط الاختبار في الحقل أعلاه ثم اضغطي "توليد" لإنشاء الباركود';
    return;
  }
  document.getElementById('qrUrl').textContent = url;
  try{
    new QRCode(document.getElementById('qrcode'), {
      text: url,
      width: 160,
      height: 160,
      colorDark: '#33302A',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M
    });
  }catch(e){
    document.getElementById('qrUrl').textContent = 'تعذّر إنشاء الباركود — تأكدي من وجود اتصال بالإنترنت عند فتح هذا الملف';
  }
}
</script>
</body>
</html>
